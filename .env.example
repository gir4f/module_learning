# PostgreSQL connection (required)
# Used by Prisma for all database operations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct PostgreSQL connection (required for migrations)
# Bypasses pgbouncer for schema changes. Use the direct port (5432).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Session secret (required in production)
# Generate a secure random string: openssl rand -base64 48
# Production fails fast if this is missing, too short, or still a placeholder.
SESSION_SECRET="change-this-to-a-random-64-char-string"

# Upload directory for local file storage (optional, defaults to ./uploads)
UPLOAD_DIR="./uploads"
