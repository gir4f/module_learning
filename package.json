{
  "name": "modul-ajar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "node ./scripts/build.mjs",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "type-check": "nuxt typecheck",
    "audit:assets": "node ./scripts/audit-assets.mjs",
    "optimize:assets": "node ./scripts/optimize-assets.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "docs:erd": "mmdc -i docs/database-erd.mmd -o docs/database-erd.svg -p docs/mermaid-puppeteer-config.json",
    "docs:flowchart": "mmdc -i docs/app-flowchart.mmd -o docs/app-flowchart.svg -p docs/mermaid-puppeteer-config.json",
    "test": "vitest run --pool=threads"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@nuxt/image": "^2.0.0",
    "@pinia/nuxt": "^0.11.2",
    "@primeuix/themes": "^2.0.3",
    "@primevue/nuxt-module": "^4.5.5",
    "@primevue/themes": "^4.5.4",
    "@prisma/client": "^6.19.0",
    "@tailwindcss/vite": "^4.3.0",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "nuxt": "^4.4.5",
    "pdfjs-dist": "^3.11.174",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tailwindcss-primeui": "^0.6.1",
    "vue-pdf-embed": "^2.1.4",
    "vue-sonner": "^2.0.9",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.12.2",
    "@vue/test-utils": "^2.4.6",
    "fast-check": "^3.23.2",
    "playwright": "^1.56.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.0",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.2.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
